generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id                 String    @id @default(cuid())
  name               String
  optedIn            Boolean   @default(false)
  lastContributionAt DateTime?
  accessPercent      Int       @default(0)
  lastDecayAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users            User[]
  patients         Patient[]
  episodes         Episode[]
  clinicalUpdates  ClinicalUpdate[]
  simulationEvents SimulationEvent[]
  accessEvents     AccessEvent[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("clinician")
  clinicId        String
  patientRecordId String?  @unique    // ← links a User account to a Patient record
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  episodes         Episode[]
  clinicalUpdates  ClinicalUpdate[]
  simulationEvents SimulationEvent[]
}

model Patient {
  id                   String    @id @default(cuid())
  firstName            String
  lastName             String
  dateOfBirth          DateTime
  phoneNumber          String    @unique
  clinicId             String
  medicareNumber       String?
  physicianName        String?
  consentStatus        String    @default("SHARE")
  consentUpdatedAt     DateTime?
  treatmentCompletedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  clinic   Clinic    @relation(fields: [clinicId], references: [id])
  episodes Episode[]
}

model Episode {
  id        String   @id @default(cuid())
  patientId String
  clinicId  String
  userId    String
  reason    String
  startDate DateTime
  createdAt DateTime @default(now())

  patient         Patient          @relation(fields: [patientId], references: [id])
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  clinicalUpdates ClinicalUpdate[]
}

model ClinicalUpdate {
  id                  String   @id @default(cuid())
  episodeId           String
  clinicId            String
  userId              String
  updateType          String   @default("STRUCTURED")
  painRegion          String
  diagnosis           String
  treatmentModalities String
  redFlags            Boolean  @default(false)
  notes               String   @default("")
  precautions         String?
  responsePattern     String?
  suggestedNextSteps  String?
  notesRaw            String?
  notesSummary        String?
  dateOfVisit           DateTime?
  patientSubmitted      Boolean  @default(false)
  submittingClinicName  String?
  submittingCarerName   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])
  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model SimulationEvent {
  id        String   @id @default(cuid())
  type      String
  clinicId  String
  userId    String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model AccessEvent {
  id         String   @id @default(cuid())
  clinicId   String
  delta      Int
  reasonCode String
  patientId  String?
  episodeId  String?
  updateId   String?
  createdAt  DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])
}
